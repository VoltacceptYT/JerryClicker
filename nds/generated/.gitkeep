#include <nds.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "sprites.h"

#define SCREEN_WIDTH 256
#define SCREEN_HEIGHT 192
#define MAX_UPGRADES 5

struct Upgrade {
    const char* name;
    int cost;
    int owned;
    int value;
};

struct GameState {
    int candies;
    int perClick;
    int autoRate;
    int prestigeLevel;
    int prestigeMultiplier;
    bool goldenActive;
    int goldenX;
    int goldenY;
    int goldenCooldown;
    Upgrade upgrades[MAX_UPGRADES];
};

static GameState game = {
    0,
    1,
    0,
    0,
    1,
    false,
    0,
    0,
    60,
    {
        {"Jerry Box", 25, 0, 1},
        {"Jerry Staff", 150, 0, 8},
        {"Jerry Rune", 1200, 0, 40},
        {"Jerry Talisman", 7500, 0, 220},
        {"Golden Jerry", 50000, 0, 3500},
    }
};

static void setPixel(int x, int y, u16 color) {
    if (x < 0 || y < 0 || x >= SCREEN_WIDTH || y >= SCREEN_HEIGHT) {
        return;
    }
    BG_GFX[y * SCREEN_WIDTH + x] = color;
}

static u16 rgbaToRgb15(uint32_t px) {
    uint8_t r = (px >> 16) & 0xFF;
    uint8_t g = (px >> 8) & 0xFF;
    uint8_t b = px & 0xFF;
    uint8_t a = (px >> 24) & 0xFF;
    if (a == 0) {
        return 0;
    }
    return RGB15(r >> 3, g >> 3, b >> 3);
}

static const SpriteMeta* findSpriteByName(const char* name) {
    for (size_t i = 0; i < sprite_count; ++i) {
        if (strcmp(sprite_list[i].name, name) == 0) {
            return &sprite_list[i];
        }
    }
    return nullptr;
}

static void drawSprite(const SpriteMeta& sprite, int x, int y) {
    const uint32_t* pixels = sprite.pixels;
    for (int py = 0; py < sprite.height; ++py) {
        for (int px = 0; px < sprite.width; ++px) {
            uint32_t p = pixels[py * sprite.width + px];
            uint8_t a = (p >> 24) & 0xFF;
            if (a == 0) {
                continue;
            }
            setPixel(x + px, y + py, rgbaToRgb15(p));
        }
    }
}

static void drawBackground(void) {
    for (int y = 0; y < SCREEN_HEIGHT; ++y) {
        for (int x = 0; x < SCREEN_WIDTH; ++x) {
            if (y < 24) {
                setPixel(x, y, RGB15(30, 20, 48));
            } else if (x > 160) {
                setPixel(x, y, RGB15(35, 26, 60));
            } else {
                setPixel(x, y, RGB15(18, 12, 30));
            }
        }
    }

    for (int x = 0; x < SCREEN_WIDTH; ++x) {
        setPixel(x, 24, RGB15(91, 73, 122));
    }

    for (int y = 26; y < SCREEN_HEIGHT; ++y) {
        for (int x = 170; x < SCREEN_WIDTH; ++x) {
            if ((x + y) % 3 == 0) {
                setPixel(x, y, RGB15(52, 38, 66));
            }
        }
    }
}

static void drawHud(void) {
    char buffer[64];
    snprintf(buffer, sizeof(buffer), "Candies: %d", game.candies);
    consoleClear();
    printf("Candies: %d\nPer click: %d\nPer sec: %d\n", game.candies, game.perClick, game.autoRate);

    const SpriteMeta* candyIcon = findSpriteByName("assets_img_ui_button_png");
    if (candyIcon) {
        drawSprite(*candyIcon, 14, 36);
    }
}

static void buyUpgrade(int index) {
    if (index < 0 || index >= MAX_UPGRADES) {
        return;
    }

    Upgrade& up = game.upgrades[index];
    if (game.candies >= up.cost) {
        game.candies -= up.cost;
        up.owned += 1;
        up.cost = (int)(up.cost * 1.55f);
        game.perClick += up.value / 2;
        game.autoRate += up.value;
    }
}

static void tryTapJerry(void) {
    game.candies += game.perClick;
}

static void maybeSpawnGoldenJerry(void) {
    if (game.goldenActive) {
        return;
    }

    if (game.goldenCooldown <= 0) {
        game.goldenX = 24 + (rand() % 140);
        game.goldenY = 44 + (rand() % 80);
        game.goldenActive = true;
        game.goldenCooldown = 180 + (rand() % 120);
    }

    game.goldenCooldown--;
}

static void claimGoldenJerry(void) {
    if (!game.goldenActive) {
        return;
    }

    game.candies += 250 + game.autoRate * 3;
    game.goldenActive = false;
    game.goldenCooldown = 90;
}

static void renderUpgradePanel(void) {
    for (int y = 28; y < 180; ++y) {
        for (int x = 170; x < 256; ++x) {
            setPixel(x, y, RGB15(40, 28, 64));
        }
    }

    for (int i = 0; i < MAX_UPGRADES; ++i) {
        int y = 34 + i * 24;
        for (int x = 176; x < 250; ++x) {
            setPixel(x, y, RGB15(72, 54, 110));
        }
    }

    for (int i = 0; i < MAX_UPGRADES; ++i) {
        int y = 34 + i * 24;
        const Upgrade& up = game.upgrades[i];
        if (up.owned > 0) {
            for (int x = 176; x < 190; ++x) {
                setPixel(x, y, RGB15(64, 200, 96));
            }
        }
    }
}

static void renderMainSprite(void) {
    const SpriteMeta* jerry = findSpriteByName("assets_img_cosmetics_jerry_png");
    if (jerry) {
        drawSprite(*jerry, 40, 54);
    }

    const SpriteMeta* candy = findSpriteByName("jerry_candy_png");
    if (candy) {
        drawSprite(*candy, 16, 36);
    }

    if (game.goldenActive) {
        const SpriteMeta* golden = findSpriteByName("golden_jerry_png");
        if (golden) {
            drawSprite(*golden, game.goldenX, game.goldenY);
        }
    }
}

int main(void) {
    videoSetMode(MODE_5_2D);
    vramSetBankA(VRAM_A_MAIN_BG);

    BG_PALETTE[0] = RGB15(0, 0, 0);
    BG_GFX = (u16*)malloc(sizeof(u16) * SCREEN_WIDTH * SCREEN_HEIGHT);
    if (!BG_GFX) {
        return 0;
    }

    srand(42);

    while (1) {
        scanKeys();
        u16 keys = keysHeld();

        if (keys & KEY_TOUCH) {
            touchPosition touch;
            touchRead(&touch);
            if (touch.px >= 40 && touch.px <= 120 && touch.py >= 54 && touch.py <= 144) {
                tryTapJerry();
            }
            if (touch.px >= 176 && touch.px <= 250 && touch.py >= 34 && touch.py <= 58) {
                buyUpgrade(0);
            }
            if (touch.px >= 176 && touch.px <= 250 && touch.py >= 58 && touch.py <= 82) {
                buyUpgrade(1);
            }
        }

        if (keys & KEY_A || keys & KEY_B || keys & KEY_X || keys & KEY_Y) {
            tryTapJerry();
        }

        if (keys & KEY_L) {
            buyUpgrade(0);
        }

        if (keys & KEY_R) {
            claimGoldenJerry();
        }

        maybeSpawnGoldenJerry();
        drawBackground();
        renderUpgradePanel();
        renderMainSprite();
        drawHud();

        swiWaitForVBlank();
    }

    return 0;
}
